#!/bin/bash
# fans - Gigabyte G5 KF fan control (unprivileged wrapper)
# All privileged work happens in fans-priv via one silent NOPASSWD sudo call.

PRIV=/usr/local/bin/fans-priv

case "${1:-}" in
  max)    exec sudo -n "$PRIV" max ;;
  auto)   exec sudo -n "$PRIV" auto ;;
  ec)     exec sudo -n "$PRIV" ec ;;
  status) exec sudo -n "$PRIV" status ;;
  ''|[[0-9]|[1-9][0-9]|100)
          if [ -z "${1:-}" ]; then
            echo "usage: fans max | fans <0-100> | fans auto | fans ec | fans status"
            exit 1
          fi
          exec sudo -n "$PRIV" pin "$1" ;;
  *) echo "usage: fans max | fans <0-100> | fans auto | fans ec | fans status" >&2; exit 1 ;;
esac
